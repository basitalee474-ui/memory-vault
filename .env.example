# Development: codes are printed in the SERVER console only (never returned by the API).
AUTH_PROVIDER=mock
# Production: use twilio (real SMS / WhatsApp). mock is refused when NODE_ENV=production.
# AUTH_PROVIDER=twilio
# TWILIO_SID=...
# TWILIO_TOKEN=...
# TWILIO_FROM=+1xxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+1xxxxxxxxxx   (optional; enables the WhatsApp option)
OTP_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3000

# Optional
# BASE_URL=https://your-domain.com       (used in invitation messages)
# ADMIN_PHONES=+923001234567              (comma-separated; these accounts become admins)
# UPLOAD_DIR=./uploads                    (where photos and recordings are stored)
